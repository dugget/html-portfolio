<% include ('partials/header.ejs') %>
    <h1>Create Post</h1>
    <form method="POST" action="/create">
       <div class="form-group">
        <label for="author">Author</label>
        <input type="text" name="author" id="postAuthor" placeholder="Enter author name" required>
       </div> 

       <div class="form-group">
        <label for="title">Title</label>
        <input type="text" name="title" id="postTitle" placeholder="Enter title" required>
       </div>

       <div class="form-group">
        <label for="body">Body</label>
        <textarea name="body" id="postBody" placeholder="Enter body" required></textarea>
       </div>

       <button type="submit" class="btn btn-default">Publish</button>
    
    </form>

<script>
    document.getElementById("createPostBtn").addEventListener("click", () => {
        window.location.href = "/create";
    })
</script>
<% include ('partials/footer.ejs') %>