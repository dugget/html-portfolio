<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Gear Closet | Strava</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --strava-orange: #fc4c02;
        --dark-bg: #121212;
        --card-bg: #1e1e1e;
        --text-primary: #ffffff;
        --text-secondary: #a0a0a0;
      }

      body {
        font-family: "Outfit", sans-serif;
        background-color: var(--dark-bg);
        color: var(--text-primary);
        margin: 0;
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .container {
        max-width: 900px;
        width: 100%;
      }

      header {
        text-align: center;
        margin-bottom: 50px;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 10px;
        background: linear-gradient(90deg, #ff8c00, #fc4c02);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      section {
        margin-bottom: 40px;
      }

      h2 {
        border-bottom: 2px solid var(--strava-orange);
        display: inline-block;
        padding-bottom: 5px;
        margin-bottom: 25px;
        font-weight: 400;
      }

      .gear-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
      }

      .gear-card {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 24px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #333;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .gear-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
        border-color: var(--strava-orange);
      }

      .gear-name {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--text-primary);
      }

      .gear-brand {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .gear-stats {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
      }

      .distance {
        font-size: 1.1rem;
        color: var(--strava-orange);
        font-weight: 600;
      }

      .distance span {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-left: 4px;
      }

      .empty-msg {
        color: var(--text-secondary);
        font-style: italic;
      }

      .back-link {
        margin-top: 50px;
        display: inline-block;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.2s;
      }

      .back-link:hover {
        color: var(--strava-orange);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>Your Athlete Closet</h1>
        <p style="color: var(--text-secondary)">
          A detailed look at your gear performance
        </p>
      </header>

      <section>
        <h2>Bikes</h2>
        <div class="gear-grid">
          <% if (gear.bikes && gear.bikes.length > 0) { %> <%
          gear.bikes.forEach(bike => { %>
          <div class="gear-card">
            <div>
              <div class="gear-brand"><%= bike.brand_name || 'Generic' %></div>
              <div class="gear-name"><%= bike.name %></div>
            </div>
            <div class="gear-stats">
              <div class="distance">
                <%= (bike.converted_distance || (bike.distance /
                1000).toFixed(1)) %>
                <span>KM</span>
              </div>
            </div>
          </div>
          <% }); %> <% } else { %>
          <p class="empty-msg">No bikes registered yet.</p>
          <% } %>
        </div>
      </section>

      <section>
        <h2>Shoes</h2>
        <div class="gear-grid">
          <% if (gear.shoes && gear.shoes.length > 0) { %> <%
          gear.shoes.forEach(shoe => { %>
          <div class="gear-card">
            <div>
              <div class="gear-brand"><%= shoe.brand_name || 'Generic' %></div>
              <div class="gear-name"><%= shoe.name %></div>
            </div>
            <div class="gear-stats">
              <div class="distance">
                <%= (shoe.converted_distance || (shoe.distance /
                1000).toFixed(1)) %>
                <span>KM</span>
              </div>
            </div>
          </div>
          <% }); %> <% } else { %>
          <p class="empty-msg">No shoes registered yet.</p>
          <% } %>
        </div>
      </section>

      <div style="text-align: center">
        <a href="/" class="back-link">← Return Home</a>
      </div>
    </div>
  </body>
</html>
